APP_NAME=wallet-service
APP_INSTANCE_ID=
APP_ROLES=api,consumer,outbox,pendingref
LOG_LEVEL=info
APP_START_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=30s

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=65536
ADMIN_ADDR=:9090

POSTGRES_USER=wallet_owner
POSTGRES_PASSWORD=local-owner-password
POSTGRES_DB=wallet
APP_DB_USER=wallet_service
APP_DB_PASSWORD=local-service-password
DATABASE_URL=postgres://wallet_service:local-service-password@postgres:5432/wallet?sslmode=disable
DATABASE_MIGRATIONS_URL=postgres://wallet_owner:local-owner-password@postgres:5432/wallet?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_LOCK_TIMEOUT=2s
DATABASE_STATEMENT_TIMEOUT=5s
DATABASE_HEALTH_TIMEOUT=2s

RETRY_ATTEMPTS=5
RETRY_BASE_DELAY=20ms
RETRY_MAX_DELAY=500ms

PENDING_TTL=30m
PENDING_BASE_DELAY=1s
PENDING_MAX_DELAY=60s
PENDING_CLAIM_LEASE=30s
PENDING_POLL_INTERVAL=1s
PENDING_BATCH_SIZE=50
PENDING_ERROR_BACKOFF=30s
PENDING_ITERATION_TIMEOUT=20s

OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLE_PERCENT=100

AUTH_ISSUER=http://localhost:8081/realms/wagering
AUTH_JWKS_URL=http://keycloak:8080/realms/wagering/protocol/openid-connect/certs
AUTH_AUDIENCE=wallet-api

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_HEALTH_TIMEOUT=2s
SQS_CONSUMER_ACCESS_KEY_ID=wager-transactions-consumer
SQS_CONSUMER_SECRET_ACCESS_KEY=local-consumer-secret
SNS_PUBLISHER_ACCESS_KEY_ID=wallet-events-publisher
SNS_PUBLISHER_SECRET_ACCESS_KEY=local-publisher-secret

SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_INPUT_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localstack:4566/000000000000/wager-transactions-dlq.fifo
SQS_CONSUMER_WORKERS=4
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME=20s
SQS_PROCESSING_TIMEOUT=10s
SQS_RETRY_BASE_DELAY=2s
SQS_RETRY_MAX_DELAY=60s
SQS_ERROR_BACKOFF=5s

SNS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wallet-events.fifo
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=5m
OUTBOX_ERROR_BACKOFF=5s

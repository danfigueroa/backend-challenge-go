{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeWagerTransactionRequests",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility", "sqs:GetQueueUrl", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:wager-transactions.fifo"
    },
    {
      "Sid": "DeadLetterPermanentFailures",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage", "sqs:GetQueueUrl", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:wager-transactions-dlq.fifo"
    }
  ]
}
